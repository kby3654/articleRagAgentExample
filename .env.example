# Google Gemini API (무료 티어) — https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_gemini_api_key_here

# 국가법령정보센터 OPEN API
LAW_API_KEY=your_law_api_key_here
LAW_API_BASE_URL=https://www.law.go.kr/DRF

# Chroma
CHROMA_PATH=./data/chroma
CHROMA_COLLECTION=law_statutes

# RAG
EMBED_MODEL=BAAI/bge-m3   # local HuggingFace model (다국어, 한국어 강함)
LLM_MODEL=gemini-2.5-flash
TOP_K=5
