# LLM API (OpenAI-compatible, 예: DeepSeek)
API_KEY=your_llm_api_key_here
API_BASE_URL=your_llm_base_url_here

# 국가법령정보센터 OPEN API
LAW_API_KEY=your_law_api_key_here
LAW_API_BASE_URL=https://www.law.go.kr/DRF

# Chroma
CHROMA_PATH=./data/chroma
CHROMA_COLLECTION=law_statutes

# RAG
EMBED_MODEL=BAAI/bge-m3   # local HuggingFace model (다국어, 한국어 강함)
LLM_MODEL=your_llm_model_here
TOP_K=5
